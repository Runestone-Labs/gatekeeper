# Runestone Gatekeeper - Environment Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# REQUIRED
# =============================================================================

# Secret for HMAC signing of approval tokens (minimum 32 characters)
# Generate with: openssl rand -base64 32
GATEKEEPER_SECRET=change-me-to-a-32-char-secret

# =============================================================================
# OPTIONAL - Server Configuration
# =============================================================================

# Port for the gatekeeper server (default: 3847)
GATEKEEPER_PORT=3847

# Base URL for approval links (default: http://localhost:${GATEKEEPER_PORT})
BASE_URL=http://localhost:3847

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# =============================================================================
# OPTIONAL - Provider Configuration
# =============================================================================

# Approval provider: local | slack | runestone (default: local)
APPROVAL_PROVIDER=local

# Approval timeout in ms (default: 3600000 = 1 hour).
# Raise this if your approver is a human checking in periodically (e.g. the
# menu-bar app) rather than watching a console — a TTL shorter than your real
# response time turns every hold into a silent expiry.
# APPROVAL_EXPIRY_MS=86400000

# Audit sink: jsonl | postgres | runestone (default: jsonl)
# - jsonl: append-only daily files under ${DATA_DIR}/audit/
# - postgres: audit_logs table (required for /audit query endpoint)
AUDIT_SINK=jsonl

# Policy source: yaml | runestone (default: yaml)
POLICY_SOURCE=yaml

# Path to policy file when using yaml source (default: ./policy.yaml)
POLICY_PATH=./policy.yaml

# Directory for data storage (approvals, audit logs)
DATA_DIR=./data

# =============================================================================
# OPTIONAL - Database (for MemoryGraph feature)
# =============================================================================

# PostgreSQL connection string (requires Apache AGE extension for graph features)
# Memory tools (memory.query, memory.upsert, memory.link, memory.unlink,
# memory.episode, memory.evidence) are disabled if DATABASE_URL is not set.
# Also used by AUDIT_SINK=postgres and the /audit query endpoint.
DATABASE_URL=postgresql://runestone:runestone_dev@localhost:5432/memory

# =============================================================================
# OPTIONAL - Slack Provider (when APPROVAL_PROVIDER=slack)
# =============================================================================

# Slack incoming webhook URL for approval notifications
SLACK_WEBHOOK_URL=

# =============================================================================
# OPTIONAL - Runestone Cloud (when using runestone providers)
# =============================================================================

# API key for Runestone Cloud authentication
RUNESTONE_API_KEY=

# Runestone Cloud API endpoint
RUNESTONE_API_URL=https://api.runestone.dev
